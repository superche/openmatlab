# M15 MIT-BIH cache (runtime-fetched from PhysioNet, ODC-By 1.0; hea/dat/atr must never be committed)
downloads/mitbih/

# M14 story figure exports (PNG/PDF generated by demos/cmapss/story_fd001.m)
demos/cmapss/out/

# M15 story figure exports (PNG/PDF generated by demos/mitbih/story_record100.m)
demos/mitbih/out/
